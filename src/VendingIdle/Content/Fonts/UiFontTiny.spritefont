<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <!-- Generated tier: see TextRenderer.FontSize. The TTF ships in the repo so the
         pipeline never depends on a system font lookup. Inter is SIL OFL 1.1;
         the licence travels with it in Inter-LICENSE.txt. -->
    <FontName>Inter-Regular.ttf</FontName>
    <Size>10</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <DefaultCharacter>?</DefaultCharacter>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#8226;</Start>
        <End>&#8226;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#215;</Start>
        <End>&#215;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#8594;</Start>
        <End>&#8594;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
